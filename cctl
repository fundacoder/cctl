"""cctl (Claude Code ctl) — list, resume and clean up Claude Code sessions.

Shows saved and open sessions with their /rename names, resumes them from any
folder, and can delete them.

Claude Code is a product of Anthropic. cctl is an unofficial utility for Claude
Code users, not made by or affiliated with Anthropic: it is only a wrapper
script that reads Claude Code's local session files and runs the `claude` CLI.

Reads transcripts from ~/.claude/projects/<project>/<session-id>.jsonl and
live-process records from ~/.claude/sessions/<pid>.json.

Examples:
  cctl                          # all sessions, newest first (= cctl ls)
  cctl ls -n -l                 # numbered, open sessions marked (open)
  cctl ls -v                    # full session IDs and transcript paths
  cctl ls --named -p api        # renamed sessions in folders matching "api"
  cctl ls -m 10 --json          # newest 10, as JSON

  cctl resume my-name           # resume by /rename name, from any folder
  cctl resume -p api            # pick from sessions in folders matching "api"
  cctl resume 3 -- --model opus # list number; args after -- go to claude

  cctl rm my-name               # delete by name, ID (or prefix), or number
  cctl rm -p /tmp/x --all       # delete every session under a folder
"""

import argparse
import json
import os
import shlex
import textwrap
import shutil
import sys
from datetime import datetime
from pathlib import Path

__version__ = "0.2.0"
